# OpenAI-compatible LLM endpoint (DeepSeek official)
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=deepseek-chat

# Agent loop settings
AGENT_MAX_ITERATIONS=10

# Session TTL (seconds): idle sessions (with their uploaded/generated files) are auto-removed
SESSION_TTL_SECONDS=1800

# Skills directory (default: backend/skills)
# SKILLS_DIR=/absolute/path/to/skills

# RAG knowledge base. Files use backend/data/knowledge/<subsystem>/<type>/filename.
# RAG_KNOWLEDGE_DIR=/absolute/path/to/backend/data/knowledge
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=80
RAG_RESULT_CHARS=6000

# Tool output safety limits. Large files should be filtered or read by windows.
TOOL_MAX_FILE_READ_BYTES=20971520
TOOL_MAX_FILE_READ_CHARS=12000
TOOL_MAX_FILE_READ_LINES=200
TOOL_MAX_WRITE_CHARS=200000
