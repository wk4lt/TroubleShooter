# OpenAI-compatible LLM endpoint (DeepSeek official)
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=deepseek-chat

# Agent loop settings
AGENT_MAX_ITERATIONS=10

# Session TTL (seconds): idle sessions (with their uploaded/generated files) are auto-removed
SESSION_TTL_SECONDS=1800

# Official OpenViking HTTP service. Start/configure it with `openviking-server init`
# and `openviking-server` before starting TroubleShooter.
OPENVIKING_URL=http://127.0.0.1:1933
OPENVIKING_API_KEY=
OPENVIKING_RESOURCE_URI=viking://resources/troubleshooter
OPENVIKING_TIMEOUT_SECONDS=30
OPENVIKING_SESSION_TOKEN_BUDGET=12000

# The official SDK uses HTTPX and honors proxy variables.  Keep local services direct.
NO_PROXY=localhost,127.0.0.1

# Skills directory (default: backend/skills)
# SKILLS_DIR=/absolute/path/to/skills

# Knowledge source directory. Its resources are imported by the official OpenViking service.
# RAG_KNOWLEDGE_DIR=/absolute/path/to/backend/data/knowledge

# Tool output safety limits. Large files should be filtered or read by windows.
TOOL_MAX_FILE_READ_BYTES=20971520
TOOL_MAX_FILE_READ_CHARS=12000
TOOL_MAX_FILE_READ_LINES=200
TOOL_MAX_WRITE_CHARS=200000
