{
  "servers": [
    {
      "name": "knowledge",
      "transport": "streamable_http",
      "expose_unprefixed": true,
      "url": "http://localhost:8010/mcp",
      "allowed_tools": [
        "search_knowledge",
        "search_runbook",
        "get_document",
        "get_context",
        "list_knowledge_bases"
      ]
    },
    {
      "name": "codegraph",
      "command": "codegraph",
      "args": ["mcp", "serve", "--root", "/path/to/repository", "--stdio"],
      "allowed_tools": [
        "explore",
        "search",
        "get_file",
        "refs",
        "goto",
        "file_deps",
        "path",
        "freshness"
      ]
    }
  ],
  "skill_tools": {
    "code-review": [
      "mcp__codegraph__explore",
      "mcp__codegraph__search",
      "mcp__codegraph__get_file",
      "mcp__codegraph__refs",
      "mcp__codegraph__goto",
      "mcp__codegraph__file_deps",
      "mcp__codegraph__path",
      "mcp__codegraph__freshness"
    ]
  }
}
